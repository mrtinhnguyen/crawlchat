# ===========================================
# HDND An Khanh - Environment Configuration
# Domain: chat.hanoi.vn
# ===========================================

# ================================
# COMMON - Required
# ================================
DATABASE_URL=mongodb://database:27017/crawlchat_hdnd_ankhanh?replicaSet=rs0
JWT_SECRET=hdnd-ankhanh-secure-jwt-secret-change-this-in-production-min-32-chars
SELF_HOSTED=true

# ================================
# URLs - Production Domain
# ================================
VITE_APP_URL=https://chat.hanoi.vn
VITE_SERVER_URL=https://api.chat.hanoi.vn
VITE_SERVER_WS_URL=wss://api.chat.hanoi.vn
VITE_SOURCE_SYNC_URL=https://sync.chat.hanoi.vn
SERVER_HOST=https://api.chat.hanoi.vn
SOURCE_SYNC_URL=http://source_sync:3000

# ================================
# DATABASE - Internal Docker URLs
# ================================
PGVECTOR_URL=postgresql://postgres:hdnd_ankhanh@pgvector:5432/crawlchat_hdnd_ankhanh
REDIS_URL=redis://redis:6379

# ================================
# AI/LLM - Required (chọn 1 trong các option sau)
# ================================

# Option 1: OpenRouter (khuyên dùng - có nhiều model)
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Option 2: OpenAI trực tiếp
OPENAI_API_KEY=your-openai-api-key-here

# Option 3: Google Gemini trực tiếp
# GEMINI_API_KEY=your-gemini-api-key-here

# Option 4: Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ================================
# MARKER SERVICE
# ================================
MARKER_HOST=http://marker:80
MARKER_API_KEY=hdnd-ankhanh-marker-api-key

# ================================
# BRANDING
# ================================
VITE_BRAND_NAME=Hội đồng nhân dân Quận An Khánh
VITE_BRAND_SLUG=hdnd-ankhanh
VITE_PRIMARY_COLOR=#DC2626

# ================================
# OPTIONAL - Email
# ================================
RESEND_KEY=
RESEND_FROM_EMAIL=noreply@hanoi.vn

# ================================
# OPTIONAL - OAuth
# ================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://chat.hanoi.vn/auth/google/callback

# ================================
# OPTIONAL - Admin
# ================================
ADMIN_EMAILS=admin@hanoi.vn

# ================================
# PLANS
# ================================
DEFAULT_SIGNUP_PLAN_ID=free

# ================================
# Queue Names (for isolation)
# ================================
GROUP_QUEUE_NAME=hdnd_ankhanh_groups
ITEM_QUEUE_NAME=hdnd_ankhanh_items
